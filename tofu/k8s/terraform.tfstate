    {
      "mode": "managed",
      "type": "kubernetes_config_map_v1",
      "name": "grafana_datasource",
      "provider": "provider[\"registry.opentofu.org/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "datasources.yaml": "apiVersion: 1\ndatasources:\n  # type: prometheus, pointing at VictoriaMetrics. That works because\n  # VictoriaMetrics speaks the Prometheus query API - which is the whole\n  # reason it was chosen over Prometheus itself.\n  - name: VictoriaMetrics\n    type: prometheus\n    access: proxy\n    url: http://victoria-metrics.observability.svc.cluster.local:8428\n    isDefault: true\n    jsonData:\n      timeInterval: 30s\n"
            },
            "id": "observability/grafana-datasources",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": null,
                "name": "grafana-datasources",
                "namespace": "observability",
                "resource_version": "5316",
                "uid": "e4e0cf67-3e36-4f5e-a1cc-d9a4c00936cd"
              }
            ]
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "kubernetes_namespace_v1.obs"
          ],
          "identity": {
            "api_version": "v1",
            "kind": "ConfigMap",
            "name": "grafana-datasources",
            "namespace": "observability"
          },
          "identity_schema_version": 1
        }
      ]
    },
    {
      "mode": "managed",
      "type": "kubernetes_config_map_v1",
      "name": "redis",
      "provider": "provider[\"registry.opentofu.org/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "redis.conf": "# Append-only file: every write is also journalled, so a restart replays\n# them. Without this, Redis only snapshots periodically and a crash loses\n# everything since the last snapshot - which for a job queue means losing\n# jobs.\nappendonly yes\nappendfsync everysec\n\n# A hard ceiling, so Redis cannot grow until the node runs out of memory\n# and the kernel kills something at random. Lower than the pod's limit on\n# purpose, so Redis evicts before Kubernetes kills it.\nmaxmemory 192mb\n\n# What to do when that ceiling is reached. allkeys-lru discards the least\n# recently used key.\n#\n# WARNING, and the reason this is written down: eviction can discard\n# stream entries, which for a job queue means silently dropping jobs. If\n# this Redis ever becomes the real queue, change this to `noeviction` so\n# that writes FAIL LOUDLY instead of data disappearing quietly.\nmaxmemory-policy allkeys-lru\n\n# Protected mode is for Redis exposed to a network with no auth. Here the\n# pod is only reachable inside the cluster. Left on; no password yet.\n# TODO: a password, from OpenBao, once T24 is done.\nsave 900 1\nsave 300 10\nsave 60 10000\n"
            },
            "id": "data/redis-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": {},
                "generate_name": "",
                "generation": 0,
                "labels": {},
                "name": "redis-config",
                "namespace": "data",
                "resource_version": "4487",
                "uid": "b6176bd6-e413-4f58-b9ab-350a01e57775"
              }
            ]
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "kubernetes_namespace_v1.data"
          ],
          "identity": {
            "api_version": "v1",
            "kind": "ConfigMap",
            "name": "redis-config",
            "namespace": "data"
          },
          "identity_schema_version": 1
        }
      ]
    },
    {
      "mode": "managed",
      "type": "kubernetes_config_map_v1",
      "name": "vm_scrape",
      "provider": "provider[\"registry.opentofu.org/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": null,
            "data": {
              "scrape.yml": "global:\n  scrape_interval: 30s\n  scrape_timeout: 10s\n\nscrape_configs:\n  # VictoriaMetrics scraping itself. Always monitor the monitor: if this\n  # series stops, the gap in every other graph is explained.\n  - job_name: victoria-metrics\n    static_configs:\n      - targets: [\"localhost:8428\"]\n\n  # The kubelet on each node: per-node CPU, memory, disk, pod counts.\n  - job_name: kubelet\n    scheme: https\n    tls_config:\n      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt\n      insecure_skip_verify: true\n    bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token\n    kubernetes_sd_configs:\n      - role: node\n    relabel_configs:\n      - action: labelmap\n        regex: __meta_kubernetes_node_label_(.+)\n      - target_label: __address__\n        replacement: kubernetes.default.svc:443\n      - source_labels: [__meta_kubernetes_node_name]\n        regex: (.+)\n        target_label: __metrics_path__\n        replacement: /api/v1/nodes/$1/proxy/metrics\n\n  # cAdvisor, also via the kubelet: PER-CONTAINER cpu and memory. This is\n  # the job that answers \"which pod is using the memory\".\n  - job_name: cadvisor\n    scheme: https\n    tls_config:\n      ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt\n      insecure_skip_verify: true\n    bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token\n    kubernetes_sd_configs:\n      - role: node\n    relabel_configs:\n      - action: labelmap\n        regex: __meta_kubernetes_node_label_(.+)\n      - target_label: __address__\n        replacement: kubernetes.default.svc:443\n      - source_labels: [__meta_kubernetes_node_name]\n        regex: (.+)\n        target_label: __metrics_path__\n        replacement: /api/v1/nodes/$1/proxy/metrics/cadvisor\n\n  # Any pod that asks to be scraped, by annotation. This is how the judge\n  # API will be picked up later with no change here.\n  - job_name: annotated-pods\n    kubernetes_sd_configs:\n      - role: pod\n    relabel_configs:\n      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_scrape]\n        action: keep\n        regex: \"true\"\n      - source_labels: [__meta_kubernetes_pod_annotation_prometheus_io_path]\n        action: replace\n        target_label: __metrics_path__\n        regex: (.+)\n      - source_labels: [__address__, __meta_kubernetes_pod_annotation_prometheus_io_port]\n        action: replace\n        regex: ([^:]+)(?::\\d+)?;(\\d+)\n        replacement: $1:$2\n        target_label: __address__\n      - source_labels: [__meta_kubernetes_namespace]\n        target_label: namespace\n      - source_labels: [__meta_kubernetes_pod_name]\n        target_label: pod\n"
            },
            "id": "observability/vm-scrape-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": null,
                "generate_name": "",
                "generation": 0,
                "labels": null,
                "name": "vm-scrape-config",
                "namespace": "observability",
                "resource_version": "5315",
                "uid": "a2078184-df0f-407f-8607-12a7e460da75"
              }
            ]
          },
          "sensitive_attributes": [],
          "private": "bnVsbA==",
          "dependencies": [
            "kubernetes_namespace_v1.obs"
          ],
          "identity": {
            "api_version": "v1",
            "kind": "ConfigMap",
            "name": "vm-scrape-config",
            "namespace": "observability"
          },
          "identity_schema_version": 1
        }
      ]
    },
